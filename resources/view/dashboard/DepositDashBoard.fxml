                  </Stop>
               </stops>
            </LinearGradient>
         </fill>
      </Rectangle>
      
      <!-- Left Side - Decorative -->
      <VBox alignment="CENTER" layoutX="50.0" layoutY="80.0" prefHeight="440.0" prefWidth="350.0" spacing="30.0">
