                        <Font name="System Bold" size="24.0" />
                     </font>
                  </Label>
               </children>
            </VBox>
            
            <!-- Information Text -->
            <VBox alignment="CENTER" spacing="20.0">
               <children>
                  <Label text="Deposita fondos fácilmente" textAlignment="CENTER" textFill="WHITE" wrapText="true">
                     <font>
                        <Font name="System Bold" size="20.0" />
