                  <Button mnemonicParsing="false" style="-fx-background-color: #f8f9fa; -fx-text-fill: #667eea; -fx-border-color: #e9ecef; -fx-border-radius: 15; -fx-background-radius: 15; -fx-cursor: hand; -fx-padding: 8 15 8 15;" text="$1000">
