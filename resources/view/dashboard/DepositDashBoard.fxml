                  <Button fx:id="btnDeposit" mnemonicParsing="false" onAction="#btnDepositClicked" prefHeight="55.0" prefWidth="320.0" style="-fx-background-color: linear-gradient(to right, #28a745 0%, #20c997 100%); -fx-text-fill: white; -fx-background-radius: 25; -fx-cursor: hand;" text="CONFIRMAR DEPÓSITO">
