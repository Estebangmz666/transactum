                  <Rectangle arcHeight="8.0" arcWidth="8.0" fill="WHITE" height="40.0" opacity="0.9" width="40.0" />
                  <Label text="BANCO DIGITAL" textFill="WHITE">
                     <font>
                        <Font name="System Bold" size="20.0" />
                     </font>
                  </Label>
               </children>
            </HBox>
            
            <!-- Spacer -->
            <HBox HBox.hgrow="ALWAYS" />
            
            <!-- User Info and Menu -->
            <HBox alignment="CENTER_RIGHT" spacing="20.0">
               <children>
                  <VBox alignment="CENTER_RIGHT">
                     <children>
                        <Label fx:id="lbWelcome" text="Bienvenido, Usuario!" textFill="WHITE">
