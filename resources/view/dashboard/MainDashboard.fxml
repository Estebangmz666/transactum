                        <Insets bottom="25.0" left="25.0" right="25.0" top="25.0" />
                     </padding>
                     <effect>
                        <DropShadow blurType="GAUSSIAN" color="#00000015" offsetY="5.0" radius="15.0" />
                     </effect>
                     <children>
                        <Label text="Resumen Financiero" textFill="#333333">
                           <font>
                              <Font name="System Bold" size="18.0" />
                           </font>
                        </Label>
                        
                        <!-- Stats Grid -->
                        <VBox spacing="12.0">
                           <children>
                              <HBox alignment="CENTER_LEFT" spacing="15.0" style="-fx-background-color: #f8f9fa; -fx-background-radius: 8;">
                                 <padding>
                                    <Insets bottom="12.0" left="15.0" right="15.0" top="12.0" />
                                 </padding>
                                 <children>
                                    <Rectangle arcHeight="6.0" arcWidth="6.0" fill="#28a745" height="20.0" width="20.0" />
                                    <VBox>
                                       <children>
                                          <Label text="Total en Cuentas" textFill="#666666">
                                             <font>
                                                <Font size="12.0" />
                                             </font>
                                          </Label>
                                          <Label text="$0.00" textFill="#333333">
                                             <font>
                                                <Font name="System Bold" size="16.0" />
                                             </font>
                                          </Label>
                                       </children>
                                    </VBox>
                                 </children>
                              </HBox>
                              
                              <HBox alignment="CENTER_LEFT" spacing="15.0" style="-fx-background-color: #f8f9fa; -fx-background-radius: 8;">
                                 <padding>
                                    <Insets bottom="12.0" left="15.0" right="15.0" top="12.0" />
                                 </padding>
                                 <children>
                                    <Rectangle arcHeight="6.0" arcWidth="6.0" fill="#007bff" height="20.0" width="20.0" />
                                    <VBox>
                                       <children>
                                          <Label text="Cuentas Activas" textFill="#666666">
                                             <font>
                                                <Font size="12.0" />
                                             </font>
                                          </Label>
                                          <Label text="0" textFill="#333333">
                                             <font>
                                                <Font name="System Bold" size="16.0" />
                                             </font>
                                          </Label>
                                       </children>
                                    </VBox>
                                 </children>
                              </HBox>
                              
                              <HBox alignment="CENTER_LEFT" spacing="15.0" style="-fx-background-color: #f8f9fa; -fx-background-radius: 8;">
                                 <padding>
                                    <Insets bottom="12.0" left="15.0" right="15.0" top="12.0" />
