                     </children>
                  </VBox>
                  <Button fx:id="btnHamburguer" mnemonicParsing="false" onAction="#btnHamburguerClicked" prefHeight="40.0" prefWidth="40.0" style="-fx-background-color: rgba(255,255,255,0.2); -fx-background-radius: 20; -fx-text-fill: white; -fx-cursor: hand;" text="☰">
                     <font>
                        <Font size="16.0" />
                     </font>
