         <fill>
            <LinearGradient endX="0.0" endY="1.0">
               <stops>
                  <Stop>
                     <color>
                        <Color red="0.95" green="0.96" blue="0.98" opacity="1.0" />
                     </color>
                  </Stop>
                  <Stop offset="1.0">
                     <color>
                        <Color red="0.90" green="0.92" blue="0.95" opacity="1.0" />
                     </color>
                  </Stop>
               </stops>
            </LinearGradient>
         </fill>
      </Rectangle>
      
      <!-- Header Section -->
      <HBox alignment="CENTER_LEFT" layoutX="0.0" layoutY="0.0" prefHeight="80.0" prefWidth="1200.0" style="-fx-background-color: linear-gradient(to right, #667eea 0%, #764ba2 100%);">
         <padding>
            <Insets left="30.0" right="30.0" />
         </padding>
         <children>
            <!-- Logo and Brand -->
            <HBox alignment="CENTER_LEFT" spacing="15.0">
