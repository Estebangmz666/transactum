                        <Button fx:id="btnGoToRecentTransactions" mnemonicParsing="false" onAction="#btnGoToRecentTransactionsClicked" prefHeight="60.0" prefWidth="380.0" style="-fx-background-color: linear-gradient(to right, #667eea 0%, #764ba2 100%); -fx-text-fill: white; -fx-background-radius: 30; -fx-cursor: hand;">
