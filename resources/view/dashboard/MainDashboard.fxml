                                             <font>
                                                <Font size="12.0" />
                                             </font>
                                          </Label>
                                          <Label text="0 pts" textFill="#333333">
                                             <font>
                                                <Font name="System Bold" size="16.0" />
                                             </font>
                                          </Label>
                                       </children>
                                    </VBox>
                                 </children>
                              </HBox>
                           </children>
                        </VBox>
                     </children>
                  </VBox>
                  
                  <!-- Help Card -->
