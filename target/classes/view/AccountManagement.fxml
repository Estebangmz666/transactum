<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>
<?import javafx.scene.effect.DropShadow?>
<?import javafx.scene.shape.Rectangle?>

<BorderPane prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/22" xmlns:fx="http://javafx.com/fxml/1" fx:controller="edu.uniquindio.proyectofinal_ds.controller.AccountManagementController">
   <top>
      <AnchorPane prefHeight="77.0" prefWidth="600.0" style="-fx-background-color: linear-gradient(to right, #2c3e50, #4a5d6e);" BorderPane.alignment="CENTER">
         <children>
            <Text fill="WHITE" layoutX="20.0" layoutY="50.0" strokeType="OUTSIDE" strokeWidth="0.0" text="Gestión de Cuenta" style="-fx-font-weight: bold;">
               <font>
                  <Font name="System Bold" size="28.0" />
               </font>
               <effect>
                  <DropShadow color="rgba(0,0,0,0.2)" radius="3.0" spread="0.5"/>
               </effect>
            </Text>
         </children>
      </AnchorPane>
   </top>
   <center>
      <AnchorPane prefHeight="200.0" prefWidth="200.0" style="-fx-background-color: #f8f9fa;" BorderPane.alignment="CENTER">
         <children>
            <Rectangle arcHeight="5.0" arcWidth="5.0" fill="WHITE" height="150.0" layoutX="50.0" layoutY="30.0" stroke="#e0e0e0" strokeType="INSIDE" width="500.0" />
            
            <Label fx:id="lblAccountId" alignment="CENTER" layoutX="50.0" layoutY="40.0" prefHeight="25.0" prefWidth="500.0" style="-fx-font-weight: bold; -fx-text-fill: #2c3e50; -fx-font-size: 14;" text="ID: " textAlignment="CENTER" />
            
            <Label fx:id="lblAccountNumber" alignment="CENTER" layoutX="50.0" layoutY="70.0" prefHeight="25.0" prefWidth="500.0" style="-fx-font-weight: bold; -fx-text-fill: #2c3e50; -fx-font-size: 14;" text="Número: " textAlignment="CENTER" />
            
            <Label fx:id="lblSaldo" alignment="CENTER" layoutX="50.0" layoutY="100.0" prefHeight="25.0" prefWidth="500.0" style="-fx-font-weight: bold; -fx-text-fill: #2c3e50; -fx-font-size: 18;" text="Saldo: " textAlignment="CENTER" />
            
            <Label fx:id="lblAccountType" alignment="CENTER" layoutX="50.0" layoutY="130.0" prefHeight="25.0" prefWidth="500.0" style="-fx-font-weight: bold; -fx-text-fill: #2c3e50; -fx-font-size: 14;" text="Tipo: " textAlignment="CENTER" />
            
            <Button fx:id="btnGoToDeposit" layoutX="50.0" layoutY="200.0" mnemonicParsing="false" onAction="#btnGoToDepositClicked" prefWidth="150.0" style="-fx-background-color: #2c3e50; -fx-background-radius: 4; -fx-cursor: hand;" text="Realizar Depósito" textFill="WHITE">
               <font>
                  <Font size="12.0" />
               </font>
            </Button>
            
            <Button fx:id="btnGoToWithdraw" layoutX="225.0" layoutY="200.0" mnemonicParsing="false" onAction="#btnGoToWithdrawClicked" prefWidth="150.0" style="-fx-background-color: #2c3e50; -fx-background-radius: 4; -fx-cursor: hand;" text="Realizar Retiro" textFill="WHITE">
               <font>
                  <Font size="12.0" />
               </font>
            </Button>
            
            <Button fx:id="btnGoToTransference" layoutX="400.0" layoutY="200.0" mnemonicParsing="false" onAction="#btnGoToTransferenceClicked" prefWidth="150.0" style="-fx-background-color: #2c3e50; -fx-background-radius: 4; -fx-cursor: hand;" text="Realizar Transferencia" textFill="WHITE">
               <font>
                  <Font size="12.0" />
               </font>
            </Button>
            
            <Button fx:id="btnDeleteAccount" layoutX="50.0" layoutY="250.0" mnemonicParsing="false" onAction="#btnDeleteAccountClicked" prefWidth="150.0" style="-fx-background-color: #e74c3c; -fx-background-radius: 4; -fx-cursor: hand;" text="Eliminar Cuenta" textFill="WHITE">
               <font>
                  <Font size="12.0" />
               </font>
            </Button>
            
            <Button fx:id="btnBack" layoutX="400.0" layoutY="250.0" mnemonicParsing="false" onAction="#btnBackClicked" prefWidth="150.0" style="-fx-background-color: transparent; -fx-border-color: #2c3e50; -fx-border-radius: 4; -fx-cursor: hand;" text="Volver" textFill="#2c3e50">
               <font>
                  <Font size="12.0" />
               </font>
            </Button>
         </children>
      </AnchorPane>
   </center>
</BorderPane>